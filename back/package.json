{
  "name": "back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/click.worker.ts",
    "worker:once": "tsx src/workers/click.worker.ts --once",
    "job:aggregate": "tsx src/jobs/aggregate-daily.ts",
    "job:aggregate:today": "tsx src/jobs/aggregate-daily.ts --today",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/click.worker.js",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "resend": "^6.21.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "autocannon": "^8.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.0"
  }
}
